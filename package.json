{
  "name": "demo-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Record polished product demo clips: a scripted Playwright take, an event log, a camera planner and a Remotion render.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "demo-kit": "bin/demo-kit.mjs"
  },
  "scripts": {
    "test": "node --test 'src/**/*.test.ts'",
    "lint": "biome check . && node scripts/no-em-dash.mjs",
    "typecheck": "tsc -p .",
    "demo-kit": "node bin/demo-kit.mjs",
    "release": "release-kit release",
    "release:check": "release-kit check && npm run lint && npm run typecheck && npm test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "playwright": "1.65.0",
    "release-kit": "github:n8watkins/release-kit#v2.10.1",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
