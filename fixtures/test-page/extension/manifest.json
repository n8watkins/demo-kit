{
  "manifest_version": 3,
  "name": "Read Aloud Test",
  "version": "0.1.0",
  "description": "demo-kit's test extension: select text on the test page and a pretend player reads it aloud, word by word.",
  "action": {
    "default_title": "Read Aloud Test",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://demo.test/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
